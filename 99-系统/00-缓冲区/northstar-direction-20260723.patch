+export async function saveDirectionFrame(
+  repository: WorkspaceRepository,
+  input: CreateWorkspaceSnapshotInput & { readonly vision: string; readonly antiVision: string },
+): Promise<WorkspaceSnapshot> {
+  return repository.withWriteLock(async () => {
+    const current = await repository.getLatestSnapshot();
+    const updated = current === null
+      ? createWorkspaceSnapshot(input)
+      : setWorkspaceDirectionFrame(current, {
+        vision: input.vision,
+        antiVision: input.antiVision,
+        timestamp: input.timestamp,
+      });
+    await repository.saveSnapshot(updated);
+    return updated;
+  });
+}
