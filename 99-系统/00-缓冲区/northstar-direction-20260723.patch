+export interface SetWorkspaceDirectionFrameInput {
+  readonly vision: string;
+  readonly antiVision: string;
+  readonly timestamp: UtcTimestamp;
+}
+
+export function setWorkspaceDirectionFrame(
+  snapshot: WorkspaceSnapshot,
+  input: SetWorkspaceDirectionFrameInput,
+): WorkspaceSnapshot {
+  return WorkspaceSnapshotSchema.parse({
+    ...snapshot,
+    vision: input.vision,
+    antiVision: input.antiVision,
+    revision: snapshot.revision + 1,
+    updatedAt: input.timestamp,
+  });
+}
